<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AC_RoomDarkener</AssemblyName>
    <RootNamespace>AC_RoomDarkener</RootNamespace>
    <Product>AC_RoomDarkener</Product>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NU1603: BepInEx.Unity.IL2CPP asks for a Cpp2IL prerelease that no longer resolves. Harmless. -->
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://pkgs.dev.azure.com/IllusionMods/Nuget/_packaging/IllusionMods/nuget/v3/index.json
    </RestoreAdditionalProjectSources>
    <!-- Optional deploy target: dotnet build -c Release -p:GameDir="S:\AICOMI\Aicomi" -->
    <GameDir Condition="'$(GameDir)' == ''"></GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="IllusionLibs.Aicomi.AllPackages" Version="2024.10.3" />
  </ItemGroup>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(GameDir)' != ''">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\AC_RoomDarkener" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\AC_RoomDarkener" />
  </Target>

</Project>
